# The profile database is personal data. Never commit it.
*.db
*.db-journal
*.sqlite

# Generated applications contain the same personal data.
output/

# Source material you drop in for import: resumes, reviews, LinkedIn exports.
inbox/*
!inbox/README.md

# Background reading only, and not ours to redistribute: saved screenshots of
# other people's LinkedIn posts, plus a saved-links file containing a personal
# access token.
resources/

# Secrets
.env

# Pipeline config holds Adzuna/USAJobs API keys. The annotated template
# (config.example.toml) is committed; your filled-in copy is not.
config.toml

# Gmail OAuth client and the cached refresh token.
gmail_credentials.json
gmail_token.json

# Generated by `jobsearch schedule install`
run_pipeline.cmd

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Frontend build (compiled by `npm run build` in frontend/)
frontend/node_modules/
frontend/dist/

# Local dev server log
server.log

# Desktop shell (npm install in desktop/); .env.local is its dev-only settings file
desktop/node_modules/
desktop/dist/
desktop/.env.local
