<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar: what the desktop shell has along its top, for the service shown below. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/back"
            style="@style/HoleButton"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:contentDescription="@string/back"
            android:paddingHorizontal="0dp"
            android:text="@string/glyph_back"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/reload"
            style="@style/HoleButton"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/reload"
            android:paddingHorizontal="0dp"
            android:text="@string/glyph_reload"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/service_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hole_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/service_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hole_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/capture"
            style="@style/HoleButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/capture" />

        <Button
            android:id="@+id/inbox"
            style="@style/HoleButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="@string/inbox_empty" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hole_line" />

    <!-- The pipeline: how it stands, and a button to run it on the server now. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hole_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/pipeline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/hole_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/update"
            style="@style/HoleButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:text="@string/update_listings" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hole_line" />

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- For a service with no address yet (Proofr), as the desktop shell asks for one. -->
        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            tools:ignore="UselessParent">

            <TextView
                android:id="@+id/empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/hole_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/empty_address"
                style="@style/HoleInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/address_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="44dp" />

            <Button
                android:id="@+id/empty_open"
                style="@style/HoleButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:text="@string/open" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hole_line" />

    <!-- The service rail, along the bottom here rather than down the side. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hole_panel"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <HorizontalScrollView
            android:id="@+id/rail_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/settings_slot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp" />
    </LinearLayout>
</LinearLayout>
